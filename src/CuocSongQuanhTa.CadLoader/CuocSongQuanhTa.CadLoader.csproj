<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CuocSongQuanhTa.CadTools</AssemblyName>
    <RootNamespace>CuocSongQuanhTa.CadLoader</RootNamespace>
    <Version>1.0.0</Version>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">D:\CAD I CAM\CAD\Product\AutoCAD 2027</AutoCADDir>
    <LoadDllDir>$(MSBuildProjectDirectory)\..\..\LOAD TOOL</LoadDllDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyLoaderDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(LoadDllDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LoadDllDir)" />
  </Target>
</Project>
