<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CuocSongQuanhTa.CadTools.Module</AssemblyName>
    <RootNamespace>CuocSongQuanhTa.CadTools</RootNamespace>
    <Version>0.2.0</Version>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCADDir>
    <ModuleDllDir>$(MSBuildProjectDirectory)\..\..\LOAD TOOL\Modules</ModuleDllDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CuocSongQuanhTa.CadLoader\CuocSongQuanhTa.CadLoader.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyModuleDll" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(ModuleDllDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleDllDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModuleDllDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
