<UserControl x:Class="CuocSongQuanhTa.CadTools.UI.BoundaryPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300"
             Background="#1D2732"
             Foreground="#F2F5F8"
             FontFamily="Segoe UI"
             FontSize="12">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#1D2732" />
        <SolidColorBrush x:Key="CardBrush" Color="#263240" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#2C3948" />
        <SolidColorBrush x:Key="RowBrush" Color="#303D4D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B4A5C" />
        <SolidColorBrush x:Key="InputBrush" Color="#354456" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2A9DE0" />
        <SolidColorBrush x:Key="YellowBrush" Color="#55C5FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9EEF4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="#16202A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F8FB" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D2DBE5" />
            <Setter Property="Margin" Value="10,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#485A6F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E0E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#344356" />
            <Setter Property="BorderBrush" Value="#17212B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.025"
                                                         Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.025"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GapZoomButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#F05CFF" />
            <Setter Property="Background" Value="#2D3948" />
            <Setter Property="BorderBrush" Value="#101820" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D6DEE7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B4859" />
                                <Setter Property="Foreground" Value="#55C5FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#313E4E" />
                                <Setter Property="Foreground" Value="#55C5FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#55C5FF" />
            <Setter Property="Background" Value="#2C3745" />
            <Setter Property="BorderBrush" Value="#121A23" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="3">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000"
                                                                  BlurRadius="2"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.70" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="27" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="9,4,2,4"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#55C5FF" />
                                                <Border Grid.Column="1" BorderBrush="#465365" BorderThickness="1,0,0,0">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#9EADBC"
                                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#263240"
                                        BorderBrush="#121A23"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="#17212B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Margin="1,1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody"
                                                        Background="#5A7085"
                                                        CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#7F96AB" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#55C5FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#18222C"
                BorderBrush="#3B4A5A"
                BorderThickness="0,0,0,1"
                Padding="11,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TMH  •  CAD TOOLS"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock x:Name="ToolSubtitleText"
                               Text="Tạo đường bao theo biên dạng rời"
                               Foreground="#91A4B7"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border x:Name="CurrentToolBadgeBorder"
                        Grid.Column="1"
                        Background="#126FAE"
                        CornerRadius="3"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentToolBadgeText"
                               Text="TẠO BIÊN"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ToolScrollViewer"
                      Grid.Row="1"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="9,9,9,12">
                <StackPanel x:Name="BoundaryContentPanel">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}" Padding="9,7" CornerRadius="3,3,0,0">
                            <DockPanel>
                                <Border Background="#126FAE" CornerRadius="2" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="01" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="ĐỐI TƯỢNG BIÊN" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="▾" Foreground="#7F93A7" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Hỗ trợ LINE, ARC, SPLINE và LWPOLYLINE. Chọn các nét rồi pick một điểm trong vùng."
                                   Foreground="#AEBBC9"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="10,8,10,9" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}" Padding="9,7" CornerRadius="3,3,0,0">
                            <DockPanel>
                                <Border Background="#126FAE" CornerRadius="2" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="02" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="XỬ LÝ KHE HỞ" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="⚙" Foreground="#55C5FF" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                        <Grid Background="{StaticResource RowBrush}" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Khe hở tối đa" Style="{StaticResource RowLabelStyle}" />
                            <TextBox x:Name="GapToleranceBox"
                                     Grid.Column="1"
                                     Margin="0,4,7,4"
                                     LostFocus="SettingsBox_OnLostFocus" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="{StaticResource RowBrush}" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Góc nối tối đa (°)" Style="{StaticResource RowLabelStyle}" />
                            <TextBox x:Name="GapAngleBox"
                                     Grid.Column="1"
                                     Margin="0,4,7,4"
                                     LostFocus="SettingsBox_OnLostFocus" />
                        </Grid>
                        <Border Background="#2B3542" Padding="9,6">
                            <TextBlock Text="●  Đoạn tự vá hiển thị màu đỏ trong preview"
                                       Foreground="#55C5FF"
                                       FontSize="10.5" />
                        </Border>
                        <Border Background="#202C38"
                                BorderBrush="#3B4A5C"
                                BorderThickness="0,1,0,0"
                                Padding="9,8"
                                CornerRadius="0,0,3,3">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" Foreground="#55C5FF" Margin="0,0,6,0" />
                                        <TextBlock Text="TỰ PHÁT HIỆN KHE"
                                                   Foreground="#CFE8F8"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border x:Name="GapScanStatusBorder"
                                            Grid.Column="1"
                                            Background="#354456"
                                            CornerRadius="3"
                                            Padding="7,2">
                                        <TextBlock x:Name="GapScanStatusText"
                                                   Text="CHƯA QUÉT"
                                                   Foreground="#9EADBC"
                                                   FontSize="9.5"
                                                   FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#2B3948" CornerRadius="3" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Số khe" Foreground="#91A4B7" FontSize="10.5" />
                                            <TextBlock x:Name="GapCountValueText"
                                                       Grid.Column="1"
                                                       Text="--"
                                                       Foreground="White"
                                                       FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Background="#2B3948" CornerRadius="3" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Khe lớn nhất" Foreground="#91A4B7" FontSize="10.5" />
                                            <TextBlock x:Name="GapMaximumValueText"
                                                       Grid.Column="1"
                                                       Text="--"
                                                       Foreground="#55C5FF"
                                                       FontWeight="Bold" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="GapDetailsText"
                                           Text="Bấm nút rồi chọn các nét. Không cần pick vùng; không tạo đường."
                                           Foreground="#8295A8"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="1,7,1,0" />

                                <WrapPanel x:Name="GapButtonsPanel"
                                           Visibility="Collapsed"
                                           Margin="0,7,0,-5" />

                                <Button Click="ScanGaps_OnClick"
                                        Background="#2D3948"
                                        BorderBrush="#101820"
                                        Height="35"
                                        Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="⌕"
                                                   Foreground="#F05CFF"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Margin="0,0,7,0" />
                                        <TextBlock Text="QUÉT KHE HỞ  +  ĐO"
                                                   Foreground="#F05CFF"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}" Padding="9,7" CornerRadius="3,3,0,0">
                            <DockPanel>
                                <Border Background="#126FAE" CornerRadius="2" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="03" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="ĐỘ CHÍNH XÁC" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="◎" Foreground="#55C5FF" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                        <Grid Background="{StaticResource RowBrush}" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sai số SPLINE" Style="{StaticResource RowLabelStyle}" />
                            <TextBox x:Name="SplineToleranceBox"
                                     Grid.Column="1"
                                     Margin="0,4,7,4"
                                     LostFocus="SettingsBox_OnLostFocus" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Border Background="{StaticResource RowBrush}" Padding="10,8" CornerRadius="0,0,3,3">
                            <CheckBox x:Name="KeepSourceCheckBox"
                                      Content="Giữ nguyên đối tượng gốc"
                                      IsChecked="True"
                                      IsEnabled="False" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}" Padding="9,7" CornerRadius="3,3,0,0">
                            <DockPanel>
                                <Border Background="#126FAE" CornerRadius="2" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="04" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="KẾT QUẢ ĐẦU RA" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="◆" Foreground="#55C5FF" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                        <Grid Background="{StaticResource RowBrush}" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="148" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Loại đường" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="OutputTypeBox"
                                      Grid.Column="1"
                                      Margin="0,4,7,4"
                                      SelectedIndex="0"
                                      Style="{StaticResource OutputComboBoxStyle}">
                                <ComboBoxItem Content="PLINE (mặc định)" Tag="Polyline" />
                                <ComboBoxItem Content="SPLINE" Tag="Spline" />
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="{StaticResource RowBrush}" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="148" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Màu kết quả" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="OutputColorBox"
                                      Grid.Column="1"
                                      Margin="0,4,7,4"
                                      SelectedIndex="0"
                                      Style="{StaticResource OutputComboBoxStyle}">
                                <ComboBoxItem Content="ByLayer (mặc định)" Tag="256" />
                                <ComboBoxItem Content="Đỏ" Tag="1" />
                                <ComboBoxItem Content="Vàng" Tag="2" />
                                <ComboBoxItem Content="Xanh lá" Tag="3" />
                                <ComboBoxItem Content="Cyan" Tag="4" />
                                <ComboBoxItem Content="Xanh dương" Tag="5" />
                                <ComboBoxItem Content="Magenta" Tag="6" />
                                <ComboBoxItem Content="Trắng / Đen" Tag="7" />
                                <ComboBoxItem Content="Xám" Tag="8" />
                            </ComboBox>
                        </Grid>
                        <Border Background="#2B3542" Padding="9,7" CornerRadius="0,0,3,3">
                            <TextBlock Text="PLINE giữ chính xác đoạn thẳng và ARC. SPLINE sẽ fit mượt toàn bộ đường bao."
                                       Foreground="#9EADBC"
                                       FontSize="10.5"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Button Click="RunBoundary_OnClick"
                        Background="#2D3948"
                        BorderBrush="#101820"
                        Height="43"
                        Margin="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="▶" Foreground="#F05CFF" Margin="0,0,8,0" FontSize="11" />
                        <TextBlock Text="CHỌN BIÊN  +  TẠO ĐƯỜNG"
                                   Foreground="#F05CFF"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Button>
                </StackPanel>

                <StackPanel x:Name="PointReductionContentPanel" Visibility="Collapsed">
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}" Padding="9,7" CornerRadius="3,3,0,0">
                            <DockPanel>
                                <Border Background="#126FAE" CornerRadius="2" Padding="5,2" Margin="0,0,7,0">
                                    <TextBlock Text="01" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="GIẢM POINT" Style="{StaticResource SectionTitleStyle}" />
