                                    Background="#2D3948"
                                    BorderBrush="#101820"
                                    Height="48"
                                    Margin="7,8,7,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✦" Foreground="#F05CFF" Margin="0,0,7,0" />
                                    <TextBlock Text="CHỌN FILE GCODE  +  TẠO HÌNH"
                                               Foreground="#F05CFF"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Background="#17212B"
                        BorderBrush="#2E3B49"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="9,7"
                        Margin="0,7,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lệnh nhanh: CQBD" Foreground="#788B9E" FontSize="10.5" />
                        <TextBlock Grid.Column="1" Text="Mở bảng: TMH" Foreground="#45B9F5" FontSize="10.5" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#18222C"
                BorderBrush="#3B4A5A"
                BorderThickness="1,0,0,0"
                ToolTip="Lăn chuột để xem thêm tool">
            <ScrollViewer x:Name="ToolTabScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          CanContentScroll="False">
            <StackPanel Margin="2,7,2,7">
                <Button x:Name="BoundaryTabButton"
                        Click="BoundaryTab_OnClick"
                        Height="88"
                        Padding="0"
                        Background="#126FAE"
                        BorderBrush="#0C527E"
                        ToolTip="Mở tool Tạo Biên">
                    <TextBlock Text="TẠO BIÊN"
                               Foreground="White"
                               FontSize="10.5"
                               FontWeight="Bold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="PointReductionTabButton"
                        Click="PointReductionTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool Giảm Point">
                    <TextBlock Text="GIẢM POINT"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="Flatten3dTabButton"
                        Click="Flatten3dTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool 3D sang 2D">
                    <TextBlock Text="3D → 2D"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="AutoDimensionTabButton"
                        Click="AutoDimensionTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool Auto Dim">
                    <TextBlock Text="AUTO DIM"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="QuickSearchTabButton"
                        Click="QuickSearchTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool Tìm Nhanh">
                    <TextBlock Text="TÌM NHANH"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="AlignmentTabButton"
                        Click="AlignmentTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool Căn Chỉnh">
                    <TextBlock Text="CĂN CHỈNH"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="GCodeTabButton"
                        Click="GCodeTab_OnClick"
                        Height="88"
                        Margin="0,5,0,0"
                        Padding="0"
                        Background="#263240"
                        BorderBrush="#101820"
                        ToolTip="Mở tool GCODE sang hình">
                    <TextBlock Text="GCODE → HÌNH"
                               Foreground="#AAB8C7"
                               FontSize="10.5"
                               FontWeight="SemiBold">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Height="30"
                Background="#151F29"
                BorderBrush="#3B4A5A"
                BorderThickness="0,1,0,0">
            <Grid>
                <Border x:Name="AuthorAccent"
                        Width="3"
                        HorizontalAlignment="Left"
                        Margin="0,5"
                        CornerRadius="0,2,2,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#55C5FF" Offset="0" />
                            <GradientStop Color="#F05CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="AuthorAccent"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.45"
                                                     To="1"
                                                     Duration="0:0:1.4" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="◆"
                               Foreground="#55C5FF"
                               FontSize="7"
                               Margin="0,0,6,0" />
                    <TextBlock Text="TÁC GIẢ : TRƯƠNG MẠNH HÀ"
                               Foreground="#9FB0C0"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="◆"
                               Foreground="#F05CFF"
                               FontSize="7"
                               Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
